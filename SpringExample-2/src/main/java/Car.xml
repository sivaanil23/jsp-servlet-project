<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="car" class="org.jsp.Car">

        <constructor-arg index="0" value="BMW"/>
        <constructor-arg index="1" value="15kmpl"/>
        <constructor-arg index="2" value="X5"/>
        <constructor-arg index="3" value="7500000"/>
        <constructor-arg index="4" value="Black"/>

    </bean>

</beans>